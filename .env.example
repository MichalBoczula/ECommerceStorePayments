PAYMENTS_APP_NAME=ECommerce Store Payments API
PAYMENTS_ENVIRONMENT=local
PAYMENTS_STRIPE_ENABLED=false
# Set PAYMENTS_STRIPE_SECRET_KEY privately when enabling test checkout.
PAYMENTS_STRIPE_SUCCESS_URL=http://localhost:4200/orders?checkout=success
PAYMENTS_STRIPE_CANCEL_URL=http://localhost:4200/orders?checkout=cancel
PAYMENTS_STRIPE_TIMEOUT_SECONDS=5
